# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Gold price API ─────────────────────────────────────────────────────────────
# metals.dev API key (optional — falls back to gold-api.com + frankfurter.app)
# Sign up at https://metals.dev
METALS_DEV_KEY=your_metals_dev_key_here

# ── Artha AI Advisor ───────────────────────────────────────────────────────────
# Anthropic API key — required for the Ask Artha chat feature
# Get yours at https://console.anthropic.com/settings/keys
# In Vercel: Settings → Environment Variables → add for Production + Preview + Development
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Supabase (if using cloud sync) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
